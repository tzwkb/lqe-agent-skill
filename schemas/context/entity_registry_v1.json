{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langlobal.example/schemas/context/entity_registry_v1.json",
  "title": "LQE entity registry v1",
  "type": "object",
  "required": ["schema", "version", "entities", "relations"],
  "properties": {
    "schema": {"const": "lqe.entities"},
    "version": {"const": 1},
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "required": ["issuer"],
      "properties": {
        "issuer": {"$ref": "#/$defs/nonempty"},
        "level": {"$ref": "#/$defs/nonempty"}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": {"$ref": "#/$defs/nonempty"},
        "container": {"$ref": "#/$defs/nonempty"},
        "coordinate": {"$ref": "#/$defs/nonempty"}
      },
      "additionalProperties": true
    },
    "fact": {
      "type": "object",
      "required": ["id", "text", "verification_status", "authority", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "text": {"$ref": "#/$defs/nonempty"},
        "verification_status": {
          "enum": ["source_backed", "verified", "candidate", "conflict"]
        },
        "authority": {"$ref": "#/$defs/authority"},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["id", "entity_type", "names", "tags", "facts"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "entity_type": {"$ref": "#/$defs/nonempty"},
        "names": {
          "type": "object",
          "required": ["source", "target"],
          "properties": {
            "source": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
            "target": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "tags": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["id", "from", "to", "relation_type", "verification_status", "authority", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "from": {"$ref": "#/$defs/nonempty"},
        "to": {"$ref": "#/$defs/nonempty"},
        "relation_type": {"$ref": "#/$defs/nonempty"},
        "attributes": {"type": "object"},
        "verification_status": {
          "enum": ["source_backed", "verified", "candidate", "conflict"]
        },
        "authority": {"$ref": "#/$defs/authority"},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    }
  }
}
