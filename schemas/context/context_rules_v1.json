{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langlobal.example/schemas/context/context_rules_v1.json",
  "title": "LQE context rules v1",
  "type": "object",
  "required": ["schema", "version", "authority_rank", "rules"],
  "properties": {
    "schema": {"const": "lqe.context-rules"},
    "version": {"const": 1},
    "authority_rank": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonempty"},
      "uniqueItems": true
    },
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "additionalProperties": false,
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "rule": {
      "type": "object",
      "required": ["id", "capability", "provider", "rule_status", "priority", "authority", "valid_from", "valid_until", "when", "expect", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "capability": {"$ref": "#/$defs/nonempty"},
        "provider": {
          "type": "object",
          "required": ["id", "api_version"],
          "properties": {
            "id": {"$ref": "#/$defs/nonempty"},
            "api_version": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "target_lang": {"$ref": "#/$defs/nonempty"},
        "rule_status": {"enum": ["confirmed", "draft", "deprecated", "rejected"]},
        "priority": {"type": "integer"},
        "authority": {
          "type": "object",
          "required": ["issuer"],
          "properties": {"issuer": {"$ref": "#/$defs/nonempty"}},
          "additionalProperties": false
        },
        "valid_from": {"type": ["string", "null"]},
        "valid_until": {"type": ["string", "null"]},
        "when": {"type": "object"},
        "expect": {"type": "object", "minProperties": 1},
        "provenance": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
