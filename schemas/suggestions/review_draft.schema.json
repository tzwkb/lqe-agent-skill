{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqe.suggestion-review-draft.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "review_packet_digest", "worker_context_manifest_digest", "worker_receipt", "reviewed_ids", "verdicts"],
  "properties": {
    "schema": {"const": "lqe.suggestion-review-draft"}, "version": {"const": 1}, "review_packet_digest": {"$ref": "#/$defs/digest"}, "worker_context_manifest_digest": {"$ref": "#/$defs/digest"}, "selected_evidence_index_digest": {"$ref": "#/$defs/digest", "description": "Required by the publisher when the packet binds a selected evidence index; must copy packet.selected_evidence_index.digest."}, "worker_receipt": {"$ref": "#/$defs/worker_receipt"}, "reviewed_ids": {"type": "array", "items": {"type": "integer"}}, "verdicts": {"type": "array", "items": {"$ref": "#/$defs/verdict"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "worker_receipt": {"type": "object", "additionalProperties": false, "required": ["worker_id", "run_id"], "properties": {"worker_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"enum": ["pass", "fail", "uncertain"]}, "evidence": {"type": "string", "minLength": 1}}},
    "semantic_verification": {"type": "object", "additionalProperties": false, "required": ["subjects", "actions", "objects", "polarity_negation", "modality", "speech_act", "text_function", "intensity", "omissions", "unsupported_additions", "tone"], "properties": {"subjects": {"$ref": "#/$defs/check"}, "actions": {"$ref": "#/$defs/check"}, "objects": {"$ref": "#/$defs/check"}, "polarity_negation": {"$ref": "#/$defs/check"}, "modality": {"$ref": "#/$defs/check"}, "speech_act": {"$ref": "#/$defs/check"}, "text_function": {"$ref": "#/$defs/check"}, "intensity": {"$ref": "#/$defs/check"}, "omissions": {"$ref": "#/$defs/check"}, "unsupported_additions": {"$ref": "#/$defs/check"}, "tone": {"$ref": "#/$defs/check"}}},
    "rule_verification": {"type": "object", "additionalProperties": false, "required": ["rule_id", "status", "evidence"], "properties": {"rule_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "fail", "uncertain"]}, "evidence": {"type": "string", "minLength": 1}}},
    "verdict": {"type": "object", "additionalProperties": false, "required": ["id", "candidate_digest", "decision", "reason_codes", "evidence", "semantic_verification"], "properties": {"id": {"type": "integer"}, "candidate_digest": {"$ref": "#/$defs/digest"}, "decision": {"enum": ["accept", "reject", "human_required"]}, "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "evidence": {"type": "string"}, "semantic_verification": {"$ref": "#/$defs/semantic_verification"}, "rule_verifications": {"type": "array", "items": {"$ref": "#/$defs/rule_verification"}}}}
  }
}
