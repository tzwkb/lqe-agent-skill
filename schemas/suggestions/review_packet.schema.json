{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqe.suggestion-review-packet.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "job_id", "job_runtime_contract_version", "state_revision_digest", "results_basis_digest", "project_asset_snapshot_digest", "capability_resolution_digest", "context_bundle_set_digest", "worker_context_manifest_digest", "protected_signature_digest", "created_at", "reviewed_ids", "candidate_artifact_digest", "entries", "instructions", "packet_digest"],
  "properties": {
    "schema": {"const": "lqe.suggestion-review-packet"}, "version": {"const": 1}, "job_id": {"type": "string"}, "job_runtime_contract_version": {"type": "integer", "minimum": 1},
    "state_revision_digest": {"$ref": "#/$defs/digest"}, "results_basis_digest": {"$ref": "#/$defs/digest"}, "project_asset_snapshot_digest": {"$ref": "#/$defs/digest"}, "capability_resolution_digest": {"$ref": "#/$defs/digest"}, "context_bundle_set_digest": {"$ref": "#/$defs/digest"}, "worker_context_manifest_digest": {"$ref": "#/$defs/digest"}, "protected_signature_digest": {"$ref": "#/$defs/digest"}, "created_at": {"type": "string"},
    "reviewed_ids": {"type": "array", "items": {"type": "integer"}}, "candidate_artifact_digest": {"$ref": "#/$defs/digest"}, "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}, "instructions": {"type": "object"}, "packet_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "required": ["id", "source", "target", "reference_target", "candidate_digest", "candidate_constraint_evaluations", "trigger_issue_ids", "known_issues", "generation_constraints", "context_projection", "context_bundle_digest"],
      "properties": {
        "id": {"type": "integer"},
        "source": {"type": "string"},
        "target": {"type": "string"},
        "reference_target": {"type": "string"},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "candidate_constraint_evaluations": {"type": "array", "items": {"type": "object"}},
        "trigger_issue_ids": {"type": "array", "items": {"type": "string"}},
        "known_issues": {"type": "array", "items": {"type": "object"}},
        "generation_constraints": {"type": "object"},
        "context_projection": {"type": "object"},
        "context_bundle_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": true
    }
  }
}
