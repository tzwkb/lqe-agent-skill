{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqe.suggestion-review-packet.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "job_id", "job_runtime_contract_version", "state_revision_digest", "results_basis_digest", "project_asset_snapshot_digest", "capability_resolution_digest", "context_bundle_set_digest", "worker_context_manifest_digest", "protected_signature_digest", "created_at", "reviewed_ids", "candidate_artifact_digest", "generation_worker_receipts", "entries", "instructions", "packet_digest"],
  "dependentRequired": {"selected_evidence_index": ["checker_worker_receipts"], "checker_worker_receipts": ["selected_evidence_index"]},
  "properties": {
    "schema": {"const": "lqe.suggestion-review-packet"}, "version": {"const": 1}, "job_id": {"type": "string"}, "job_runtime_contract_version": {"type": "integer", "minimum": 1},
    "state_revision_digest": {"$ref": "#/$defs/digest"}, "results_basis_digest": {"$ref": "#/$defs/digest"}, "project_asset_snapshot_digest": {"$ref": "#/$defs/digest"}, "capability_resolution_digest": {"$ref": "#/$defs/digest"}, "context_bundle_set_digest": {"$ref": "#/$defs/digest"}, "worker_context_manifest_digest": {"$ref": "#/$defs/digest"}, "protected_signature_digest": {"$ref": "#/$defs/digest"}, "created_at": {"type": "string"},
    "reviewed_ids": {"type": "array", "items": {"type": "integer"}}, "candidate_artifact_digest": {"$ref": "#/$defs/digest"}, "generation_worker_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/worker_receipt"}}, "selected_evidence_index": {"$ref": "#/$defs/evidence_binding"}, "checker_worker_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "description": "Verifier worker_id and run_id values must each be disjoint from these checker identities and from generation identities.", "items": {"$ref": "#/$defs/worker_receipt"}}, "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}, "batch_plan": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "batch_count"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "batch_count": {"type": "integer", "minimum": 1}}}, "instructions": {"type": "object"}, "packet_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_binding": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "entry": {
      "type": "object",
      "required": ["id", "source", "target", "reference_target", "source_semantics", "tone_decision", "candidate_digest", "candidate_constraint_evaluations", "trigger_issue_ids", "known_issues", "generation_constraints", "context_projection", "context_bundle_digest"],
      "properties": {
        "id": {"type": "integer"},
        "source": {"type": "string"},
        "target": {"type": "string"},
        "reference_target": {"type": "string"},
        "source_semantics": {"$ref": "#/$defs/source_semantics"},
        "tone_decision": {"$ref": "#/$defs/tone_decision"},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "candidate_constraint_evaluations": {"type": "array", "items": {"type": "object"}},
        "trigger_issue_ids": {"type": "array", "items": {"type": "string"}},
        "known_issues": {"type": "array", "items": {"type": "object"}},
        "generation_constraints": {"type": "object"},
        "context_projection": {"type": "object"},
        "context_bundle_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": true
    },
    "worker_receipt": {"type": "object", "additionalProperties": false, "required": ["worker_id", "run_id"], "properties": {"worker_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}}},
    "source_semantics": {"type": "object", "additionalProperties": false, "required": ["subjects", "actions", "objects", "negation", "polarity", "modality", "speech_act", "text_function", "intensity", "omitted_source_elements", "unsupported_additions"], "properties": {"subjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "objects": {"type": "array", "items": {"type": "string", "minLength": 1}}, "negation": {"type": "object", "additionalProperties": false, "required": ["present", "scope"], "properties": {"present": {"type": "boolean"}, "scope": {"type": ["string", "null"]}}}, "polarity": {"type": "string", "minLength": 1}, "modality": {"type": "array", "items": {"type": "string", "minLength": 1}}, "speech_act": {"type": "string", "minLength": 1}, "text_function": {"type": "string", "minLength": 1}, "intensity": {"type": "string", "minLength": 1}, "omitted_source_elements": {"type": "array", "items": {"type": "string", "minLength": 1}}, "unsupported_additions": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "tone_decision": {"type": "object", "additionalProperties": false, "required": ["register", "politeness", "depends_on_dialogue_context", "evidence", "uncertainties"], "properties": {"register": {"type": "string", "minLength": 1}, "politeness": {"type": "string", "minLength": 1}, "depends_on_dialogue_context": {"type": "boolean"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}}}, "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
  }
}
