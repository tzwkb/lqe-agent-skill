{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqe.reference-suggestions.v5",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "job_id", "job_runtime_contract_version", "state_revision_digest", "results_basis_digest", "project_asset_snapshot_digest", "capability_resolution_digest", "context_bundle_set_digest", "worker_context_manifest_digest", "protected_signature_digest", "created_at", "reviewed_ids", "selection", "candidate_artifact_digest", "review_artifact_digest", "generation_worker_receipts", "review_worker_receipts", "final_entries", "excluded_ids", "publisher_receipt", "artifact_digest"],
  "dependentRequired": {"selected_evidence_index": ["checker_worker_receipts"], "checker_worker_receipts": ["selected_evidence_index"]},
  "properties": {
    "schema": {"const": "lqe.reference-suggestions"}, "version": {"const": 5}, "job_id": {"type": "string"}, "job_runtime_contract_version": {"type": "integer", "minimum": 1},
    "state_revision_digest": {"$ref": "#/$defs/digest"}, "results_basis_digest": {"$ref": "#/$defs/digest"}, "project_asset_snapshot_digest": {"$ref": "#/$defs/digest"}, "capability_resolution_digest": {"$ref": "#/$defs/digest"}, "context_bundle_set_digest": {"$ref": "#/$defs/digest"}, "worker_context_manifest_digest": {"$ref": "#/$defs/digest"}, "protected_signature_digest": {"$ref": "#/$defs/digest"}, "created_at": {"type": "string"},
    "reviewed_ids": {"type": "array", "items": {"type": "integer"}}, "selection": {"type": "object"}, "candidate_artifact_digest": {"$ref": "#/$defs/digest"}, "review_artifact_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "generation_worker_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/worker_receipt"}}, "review_worker_receipts": {"type": "array", "items": {"$ref": "#/$defs/worker_receipt"}}, "selected_evidence_index": {"$ref": "#/$defs/evidence_binding"}, "checker_worker_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "description": "All generation and review worker_id/run_id values must each remain disjoint from these checker identities.", "items": {"$ref": "#/$defs/worker_receipt"}},
    "final_entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}, "excluded_ids": {"type": "array", "items": {"$ref": "#/$defs/excluded"}}, "publisher_receipt": {"$ref": "#/$defs/receipt"}, "artifact_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_binding": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "worker_receipt": {"type": "object", "additionalProperties": false, "required": ["worker_id", "run_id"], "properties": {"worker_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}}},
    "source_semantics": {"type": "object", "additionalProperties": false, "required": ["subjects", "actions", "objects", "negation", "polarity", "modality", "speech_act", "text_function", "intensity", "omitted_source_elements", "unsupported_additions"], "properties": {"subjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "objects": {"type": "array", "items": {"type": "string", "minLength": 1}}, "negation": {"type": "object", "additionalProperties": false, "required": ["present", "scope"], "properties": {"present": {"type": "boolean"}, "scope": {"type": ["string", "null"]}}}, "polarity": {"type": "string", "minLength": 1}, "modality": {"type": "array", "items": {"type": "string", "minLength": 1}}, "speech_act": {"type": "string", "minLength": 1}, "text_function": {"type": "string", "minLength": 1}, "intensity": {"type": "string", "minLength": 1}, "omitted_source_elements": {"type": "array", "items": {"type": "string", "minLength": 1}}, "unsupported_additions": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "tone_decision": {"type": "object", "additionalProperties": false, "required": ["register", "politeness", "depends_on_dialogue_context", "evidence", "uncertainties"], "properties": {"register": {"type": "string", "minLength": 1}, "politeness": {"type": "string", "minLength": 1}, "depends_on_dialogue_context": {"type": "boolean"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}}}, "uncertainties": {"type": "array", "maxItems": 0, "items": {"type": "string", "minLength": 1}}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"enum": ["pass", "fail", "uncertain"]}, "evidence": {"type": "string", "minLength": 1}}},
    "semantic_verification": {"type": "object", "additionalProperties": false, "required": ["subjects", "actions", "objects", "polarity_negation", "modality", "speech_act", "text_function", "intensity", "omissions", "unsupported_additions", "tone"], "properties": {"subjects": {"$ref": "#/$defs/check"}, "actions": {"$ref": "#/$defs/check"}, "objects": {"$ref": "#/$defs/check"}, "polarity_negation": {"$ref": "#/$defs/check"}, "modality": {"$ref": "#/$defs/check"}, "speech_act": {"$ref": "#/$defs/check"}, "text_function": {"$ref": "#/$defs/check"}, "intensity": {"$ref": "#/$defs/check"}, "omissions": {"$ref": "#/$defs/check"}, "unsupported_additions": {"$ref": "#/$defs/check"}, "tone": {"$ref": "#/$defs/check"}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["id", "reference_target", "source_semantics", "tone_decision", "semantic_verification", "candidate_digest", "risk_route"], "properties": {"id": {"type": "integer"}, "reference_target": {"type": "string"}, "source_semantics": {"$ref": "#/$defs/source_semantics"}, "tone_decision": {"$ref": "#/$defs/tone_decision"}, "semantic_verification": {"$ref": "#/$defs/semantic_verification"}, "candidate_digest": {"$ref": "#/$defs/digest"}, "risk_route": {"const": "independent_verifier"}}},
    "excluded": {"type": "object", "additionalProperties": false, "required": ["id", "reason_codes"], "properties": {"id": {"type": "integer"}, "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["publisher", "basis_digest", "receipt_digest"], "properties": {"publisher": {"type": "string"}, "basis_digest": {"$ref": "#/$defs/digest"}, "receipt_digest": {"$ref": "#/$defs/digest"}}}
  }
}
