{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqe.suggestion-review.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "job_id", "job_runtime_contract_version", "state_revision_digest", "results_basis_digest", "project_asset_snapshot_digest", "capability_resolution_digest", "context_bundle_set_digest", "worker_context_manifest_digest", "protected_signature_digest", "created_at", "reviewed_ids", "candidate_artifact_digest", "review_packet_digest", "review_draft_digest", "verdicts", "publisher_receipt", "artifact_digest"],
  "properties": {
    "schema": {"const": "lqe.suggestion-review"}, "version": {"const": 1}, "job_id": {"type": "string"}, "job_runtime_contract_version": {"type": "integer", "minimum": 1},
    "state_revision_digest": {"$ref": "#/$defs/digest"}, "results_basis_digest": {"$ref": "#/$defs/digest"}, "project_asset_snapshot_digest": {"$ref": "#/$defs/digest"}, "capability_resolution_digest": {"$ref": "#/$defs/digest"}, "context_bundle_set_digest": {"$ref": "#/$defs/digest"}, "worker_context_manifest_digest": {"$ref": "#/$defs/digest"}, "protected_signature_digest": {"$ref": "#/$defs/digest"}, "created_at": {"type": "string"},
    "reviewed_ids": {"type": "array", "items": {"type": "integer"}}, "candidate_artifact_digest": {"$ref": "#/$defs/digest"}, "review_packet_digest": {"$ref": "#/$defs/digest"}, "review_draft_digest": {"$ref": "#/$defs/digest"}, "verdicts": {"type": "array", "items": {"$ref": "#/$defs/verdict"}}, "publisher_receipt": {"$ref": "#/$defs/receipt"}, "artifact_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"type": "object", "additionalProperties": false, "required": ["id", "candidate_digest", "decision", "reason_codes", "evidence"], "properties": {"id": {"type": "integer"}, "candidate_digest": {"$ref": "#/$defs/digest"}, "decision": {"enum": ["accept", "reject", "human_required"]}, "reason_codes": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "string"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["publisher", "basis_digest", "receipt_digest"], "properties": {"publisher": {"type": "string"}, "basis_digest": {"$ref": "#/$defs/digest"}, "receipt_digest": {"$ref": "#/$defs/digest"}}}
  }
}
