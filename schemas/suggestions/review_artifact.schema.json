{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqe.suggestion-review.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "job_id", "job_runtime_contract_version", "state_revision_digest", "results_basis_digest", "project_asset_snapshot_digest", "capability_resolution_digest", "context_bundle_set_digest", "worker_context_manifest_digest", "protected_signature_digest", "created_at", "reviewed_ids", "candidate_artifact_digest", "review_packet_digest", "review_draft_digest", "generation_worker_receipts", "review_worker_receipts", "verdicts", "publisher_receipt", "artifact_digest"],
  "dependentRequired": {"selected_evidence_index": ["checker_worker_receipts"], "checker_worker_receipts": ["selected_evidence_index"]},
  "properties": {
    "schema": {"const": "lqe.suggestion-review"}, "version": {"const": 1}, "job_id": {"type": "string"}, "job_runtime_contract_version": {"type": "integer", "minimum": 1},
    "state_revision_digest": {"$ref": "#/$defs/digest"}, "results_basis_digest": {"$ref": "#/$defs/digest"}, "project_asset_snapshot_digest": {"$ref": "#/$defs/digest"}, "capability_resolution_digest": {"$ref": "#/$defs/digest"}, "context_bundle_set_digest": {"$ref": "#/$defs/digest"}, "worker_context_manifest_digest": {"$ref": "#/$defs/digest"}, "protected_signature_digest": {"$ref": "#/$defs/digest"}, "created_at": {"type": "string"},
    "reviewed_ids": {"type": "array", "items": {"type": "integer"}}, "candidate_artifact_digest": {"$ref": "#/$defs/digest"}, "review_packet_digest": {"$ref": "#/$defs/digest"}, "review_draft_digest": {"$ref": "#/$defs/digest"}, "generation_worker_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/worker_receipt"}}, "review_worker_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/worker_receipt"}}, "selected_evidence_index": {"$ref": "#/$defs/evidence_binding"}, "checker_worker_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "description": "Generation and review worker_id/run_id values must each remain disjoint from these checker identities.", "items": {"$ref": "#/$defs/worker_receipt"}}, "review_batches": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "verdicts": {"type": "array", "items": {"$ref": "#/$defs/verdict"}}, "publisher_receipt": {"$ref": "#/$defs/receipt"}, "artifact_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_binding": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "worker_receipt": {"type": "object", "additionalProperties": false, "required": ["worker_id", "run_id"], "properties": {"worker_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"enum": ["pass", "fail", "uncertain"]}, "evidence": {"type": "string", "minLength": 1}}},
    "semantic_verification": {"type": "object", "additionalProperties": false, "required": ["subjects", "actions", "objects", "polarity_negation", "modality", "speech_act", "text_function", "intensity", "omissions", "unsupported_additions", "tone"], "properties": {"subjects": {"$ref": "#/$defs/check"}, "actions": {"$ref": "#/$defs/check"}, "objects": {"$ref": "#/$defs/check"}, "polarity_negation": {"$ref": "#/$defs/check"}, "modality": {"$ref": "#/$defs/check"}, "speech_act": {"$ref": "#/$defs/check"}, "text_function": {"$ref": "#/$defs/check"}, "intensity": {"$ref": "#/$defs/check"}, "omissions": {"$ref": "#/$defs/check"}, "unsupported_additions": {"$ref": "#/$defs/check"}, "tone": {"$ref": "#/$defs/check"}}},
    "verdict": {"type": "object", "additionalProperties": false, "required": ["id", "candidate_digest", "decision", "reason_codes", "evidence", "semantic_verification"], "properties": {"id": {"type": "integer"}, "candidate_digest": {"$ref": "#/$defs/digest"}, "decision": {"enum": ["accept", "reject", "human_required"]}, "reason_codes": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "string"}, "semantic_verification": {"$ref": "#/$defs/semantic_verification"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["publisher", "basis_digest", "receipt_digest"], "properties": {"publisher": {"type": "string"}, "basis_digest": {"$ref": "#/$defs/digest"}, "receipt_digest": {"$ref": "#/$defs/digest"}}}
  }
}
