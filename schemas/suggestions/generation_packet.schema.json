{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqe.reference-suggestion-generation-packet.v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "job_id", "job_runtime_contract_version", "state_revision_digest", "results_basis_digest", "project_asset_snapshot_digest", "capability_resolution_digest", "context_bundle_set_digest", "worker_context_manifest_digest", "protected_signature_digest", "created_at", "manifest_digest", "review_policy", "selection", "reviewed_ids", "review_receipts", "excluded_segments", "segments", "instructions", "packet_digest"],
  "dependentRequired": {"selected_evidence_index": ["checker_worker_receipts"], "checker_worker_receipts": ["selected_evidence_index"]},
  "properties": {
    "schema": {"const": "lqe.reference-suggestion-generation-packet"},
    "version": {"const": 5},
    "job_id": {"type": "string", "minLength": 1},
    "job_runtime_contract_version": {"type": "integer", "minimum": 1},
    "state_revision_digest": {"$ref": "#/$defs/digest"},
    "results_basis_digest": {"$ref": "#/$defs/digest"},
    "project_asset_snapshot_digest": {"$ref": "#/$defs/digest"},
    "capability_resolution_digest": {"$ref": "#/$defs/digest"},
    "context_bundle_set_digest": {"$ref": "#/$defs/digest"},
    "worker_context_manifest_digest": {"$ref": "#/$defs/digest"},
    "protected_signature_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "minLength": 1},
    "manifest_digest": {"type": ["string", "null"]},
    "review_policy": {"type": "object"},
    "selection": {"$ref": "#/$defs/selection"},
    "reviewed_ids": {"$ref": "#/$defs/ids"},
    "review_receipts": {"type": "array", "items": {"type": "object"}},
    "context_view_basis": {"type": "object"},
    "content_index": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "selected_evidence_index": {"$ref": "#/$defs/evidence_binding"},
    "checker_worker_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "description": "Checker identities bound to the selected evidence. A generation worker must use both a worker_id and a run_id absent from this list.", "items": {"$ref": "#/$defs/worker_receipt"}},
    "batch_plan": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "batch_count"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "batch_count": {"type": "integer", "minimum": 2}}},
    "excluded_segments": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "segments": {"type": "array", "items": {"type": "object", "required": ["id", "source", "target", "validated_target", "trigger_issue_ids", "known_issues", "generation_constraints"], "properties": {"id": {"type": "integer"}, "source": {"type": "string"}, "target": {"type": "string"}, "validated_target": {"type": ["string", "null"]}, "trigger_issue_ids": {"type": "array", "items": {"type": "string"}}, "known_issues": {"type": "array", "items": {"type": "object"}}, "generation_constraints": {"type": "object"}, "checker_selected_evidence": {"type": "object", "description": "Authoritative strict union of the evidence actually selected by checker modules for this segment."}, "context_projection": {"type": "object"}, "context_bundle_digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": true}},
    "instructions": {"type": "object"},
    "packet_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_binding": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "worker_receipt": {"type": "object", "additionalProperties": false, "required": ["worker_id", "run_id"], "properties": {"worker_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}}},
    "ids": {"type": "array", "items": {"type": "integer"}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["categories", "severities", "only_missing"], "properties": {"categories": {"type": "array", "items": {"type": "string"}}, "severities": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "only_missing": {"type": "boolean"}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["id", "risk_route", "reason_codes"], "properties": {"id": {"type": "integer"}, "risk_route": {"const": "hard_reject"}, "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}
  }
}
