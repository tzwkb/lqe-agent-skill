{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqe.reference-suggestion-candidates.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "job_id", "job_runtime_contract_version", "state_revision_digest", "results_basis_digest", "project_asset_snapshot_digest", "capability_resolution_digest", "context_bundle_set_digest", "worker_context_manifest_digest", "protected_signature_digest", "created_at", "reviewed_ids", "selection", "generation_packet_digest", "generation_draft_digest", "generation_worker_receipts", "abstention_reasons", "routes", "entries", "publisher_receipt", "artifact_digest"],
  "dependentRequired": {"selected_evidence_index": ["checker_worker_receipts"], "checker_worker_receipts": ["selected_evidence_index"]},
  "properties": {
    "schema": {"const": "lqe.reference-suggestion-candidates"}, "version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1}, "job_runtime_contract_version": {"type": "integer", "minimum": 1},
    "state_revision_digest": {"$ref": "#/$defs/digest"}, "results_basis_digest": {"$ref": "#/$defs/digest"}, "project_asset_snapshot_digest": {"$ref": "#/$defs/digest"}, "capability_resolution_digest": {"$ref": "#/$defs/digest"}, "context_bundle_set_digest": {"$ref": "#/$defs/digest"}, "worker_context_manifest_digest": {"$ref": "#/$defs/digest"}, "protected_signature_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "minLength": 1}, "reviewed_ids": {"type": "array", "items": {"type": "integer"}}, "selection": {"type": "object"},
    "selected_evidence_index": {"$ref": "#/$defs/evidence_binding"},
    "checker_worker_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "description": "Generation worker_id and run_id values must each be disjoint from these checker identities.", "items": {"$ref": "#/$defs/worker_receipt"}},
    "generation_packet_digest": {"$ref": "#/$defs/digest"}, "generation_draft_digest": {"$ref": "#/$defs/digest"},
    "generation_worker_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/worker_receipt"}},
    "abstention_reasons": {"type": "array", "items": {"$ref": "#/$defs/abstention_reason"}},
    "generation_batches": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}}, "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "publisher_receipt": {"$ref": "#/$defs/receipt"}, "artifact_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_binding": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["id", "risk_route", "reason_codes"], "properties": {"id": {"type": "integer"}, "risk_route": {"enum": ["hard_reject", "deterministic_accept", "independent_verifier"]}, "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "candidate_digest": {"$ref": "#/$defs/digest"}, "candidate_constraint_evaluations": {"type": "array", "items": {"type": "object"}}}},
    "worker_receipt": {"type": "object", "additionalProperties": false, "required": ["worker_id", "run_id"], "properties": {"worker_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}}},
    "abstention_reason": {"type": "object", "additionalProperties": false, "required": ["id", "reason_codes", "evidence"], "properties": {"id": {"type": "integer"}, "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidence": {"type": "string", "minLength": 1}}},
    "source_semantics": {"type": "object", "additionalProperties": false, "required": ["subjects", "actions", "objects", "negation", "polarity", "modality", "speech_act", "text_function", "intensity", "omitted_source_elements", "unsupported_additions"], "properties": {"subjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "objects": {"type": "array", "items": {"type": "string", "minLength": 1}}, "negation": {"type": "object", "additionalProperties": false, "required": ["present", "scope"], "properties": {"present": {"type": "boolean"}, "scope": {"type": ["string", "null"]}}}, "polarity": {"type": "string", "minLength": 1}, "modality": {"type": "array", "items": {"type": "string", "minLength": 1}}, "speech_act": {"type": "string", "minLength": 1}, "text_function": {"type": "string", "minLength": 1}, "intensity": {"type": "string", "minLength": 1}, "omitted_source_elements": {"type": "array", "items": {"type": "string", "minLength": 1}}, "unsupported_additions": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "tone_decision": {"type": "object", "additionalProperties": false, "required": ["register", "politeness", "depends_on_dialogue_context", "evidence", "uncertainties"], "properties": {"register": {"type": "string", "minLength": 1}, "politeness": {"type": "string", "minLength": 1}, "depends_on_dialogue_context": {"type": "boolean"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}}}, "uncertainties": {"type": "array", "maxItems": 0, "items": {"type": "string", "minLength": 1}}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["id", "reference_target", "source_semantics", "tone_decision", "candidate_digest"], "properties": {"id": {"type": "integer"}, "reference_target": {"type": "string"}, "source_semantics": {"$ref": "#/$defs/source_semantics"}, "tone_decision": {"$ref": "#/$defs/tone_decision"}, "candidate_digest": {"$ref": "#/$defs/digest"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["publisher", "basis_digest", "receipt_digest"], "properties": {"publisher": {"type": "string"}, "basis_digest": {"$ref": "#/$defs/digest"}, "receipt_digest": {"$ref": "#/$defs/digest"}}}
  }
}
