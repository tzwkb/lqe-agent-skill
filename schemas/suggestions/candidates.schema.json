{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lqe.reference-suggestion-candidates.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "job_id", "job_runtime_contract_version", "state_revision_digest", "results_basis_digest", "project_asset_snapshot_digest", "capability_resolution_digest", "context_bundle_set_digest", "worker_context_manifest_digest", "protected_signature_digest", "created_at", "reviewed_ids", "selection", "generation_packet_digest", "generation_draft_digest", "routes", "entries", "publisher_receipt", "artifact_digest"],
  "properties": {
    "schema": {"const": "lqe.reference-suggestion-candidates"}, "version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1}, "job_runtime_contract_version": {"type": "integer", "minimum": 1},
    "state_revision_digest": {"$ref": "#/$defs/digest"}, "results_basis_digest": {"$ref": "#/$defs/digest"}, "project_asset_snapshot_digest": {"$ref": "#/$defs/digest"}, "capability_resolution_digest": {"$ref": "#/$defs/digest"}, "context_bundle_set_digest": {"$ref": "#/$defs/digest"}, "worker_context_manifest_digest": {"$ref": "#/$defs/digest"}, "protected_signature_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "minLength": 1}, "reviewed_ids": {"type": "array", "items": {"type": "integer"}}, "selection": {"type": "object"},
    "generation_packet_digest": {"$ref": "#/$defs/digest"}, "generation_draft_digest": {"$ref": "#/$defs/digest"},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}}, "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "publisher_receipt": {"$ref": "#/$defs/receipt"}, "artifact_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route": {"type": "object", "additionalProperties": false, "required": ["id", "risk_route", "reason_codes"], "properties": {"id": {"type": "integer"}, "risk_route": {"enum": ["hard_reject", "deterministic_accept", "independent_verifier"]}, "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "candidate_digest": {"$ref": "#/$defs/digest"}, "candidate_constraint_evaluations": {"type": "array", "items": {"type": "object"}}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["id", "reference_target", "candidate_digest"], "properties": {"id": {"type": "integer"}, "reference_target": {"type": "string"}, "candidate_digest": {"$ref": "#/$defs/digest"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["publisher", "basis_digest", "receipt_digest"], "properties": {"publisher": {"type": "string"}, "basis_digest": {"$ref": "#/$defs/digest"}, "receipt_digest": {"$ref": "#/$defs/digest"}}}
  }
}
