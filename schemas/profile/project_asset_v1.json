{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langlobal.example/schemas/lqe/project-asset-v1.json",
  "title": "LQE project asset declaration v1",
  "type": "object",
  "required": [
    "kind",
    "path",
    "required",
    "authority",
    "provenance",
    "distribution",
    "availability"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "path": {"type": "string", "minLength": 1},
    "required": {"type": "boolean"},
    "authority": {
      "type": "object",
      "required": ["issuer"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "level": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "distribution": {
      "enum": ["public_allowed", "internal_only", "redacted"]
    },
    "availability": {"enum": ["included", "external"]},
    "description": {"type": "string", "minLength": 1},
    "media_type": {"type": "string", "minLength": 1},
    "content_schema": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
