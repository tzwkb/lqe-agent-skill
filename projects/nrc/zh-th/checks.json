{
  "builtin": {},
  "custom": [
    {
      "id": "th-multi-punct",
      "pattern": "(!{2,}|\\?{2,}|！{2,}|？{2,})",
      "where": "target",
      "category": "Punctuation",
      "severity": "Minor",
      "comment": "TH SG: 禁连续同种感叹/问号 (??? → ?)；混合 ?!/!? 不算 (审校确认 2026-06-11)"
    },
    {
      "id": "th-cjk-ellipsis",
      "pattern": "……|。。。|…",
      "where": "target",
      "category": "Punctuation",
      "severity": "Minor",
      "comment": "TH SG: 省略号用三个英文点 ..."
    }
  ],
  "suggestion_candidate_rules": [
    {
      "id": "nrc-creature-name-max-12",
      "type": "max_target_length",
      "max_characters": 12,
      "source_regex": "精灵$",
      "segment_kinds": ["name"],
      "reason_code": "CREATURE_NAME_LENGTH_EXCEEDED"
    }
  ]
}
